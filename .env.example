# Sao chép file này thành .env và điền giá trị thật. KHÔNG commit file .env.

# ---- LLM (sinh tiêu đề) ----
# Bắt buộc nếu llm.provider = groq (mặc định)
GROQ_API_KEY=

# Chỉ cần nếu llm.provider = claude
ANTHROPIC_API_KEY=

# ---- Sinh ảnh AI (photos.source = ai_generated) ----
# Chỉ cần nếu image_generation.provider = openai. Provider mặc định "pollinations" MIỄN PHÍ,
# không cần key.
OPENAI_API_KEY=

# ---- YouTube Data API v3 (OAuth "installed app" credentials) ----
# Xem hướng dẫn lấy các giá trị này trong README.md
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ID playlist muốn thêm video vào (có thể override config/config.yaml -> youtube.playlist_id)
YOUTUBE_PLAYLIST_ID=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
